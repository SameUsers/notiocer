# Скопируйте в .env и заполните доступы. Имена чувствительны к регистру.
ax__odbc_driver=ODBC Driver 17 for SQL Server
ax__server=sql.example.local
ax__database=AX_DATABASE
ax__username=CHANGE_ME
ax__password=CHANGE_ME
ax__cache_path=data/user_cache.json

exchange__username=mailer@example.com
exchange__password=CHANGE_ME

invoice_report_file__path=workdir/DZ_Report.xls
mailing_rules_file=config/invoice_routing_rules.yml
invoice_selection__allowed_categories=["Д0","Д1","Д2","Д3","Д4","Д5","Д60"]
invoice_selection__minimum_invoice_age=P3D
message__subject=Неполученные предоплаты до загрузки
# message__body=Собственный текст письма
